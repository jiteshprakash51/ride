/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache

/app/*
  Cache-Control: no-cache
/app/sw.js
  Service-Worker-Allowed: /app/
  Cache-Control: no-cache
